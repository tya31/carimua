# Salin file ini menjadi ".env", lalu isi dengan data dari dashboard Supabase:
# Project Settings → API Keys (atau "Connect" di bagian atas dashboard).

# --- Dipakai oleh website (aman dipakai di browser) ---
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# "Publishable key" (sb_publishable_...) ATAU "anon public" key (legacy). Keduanya boleh.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# --- Hanya untuk script "npm run seed" di laptopmu. RAHASIA! ---
# "Secret key" (sb_secret_...) ATAU "service_role" key (legacy).
# Jangan pernah diawali VITE_ dan jangan pernah dimasukkan ke Vercel.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx
